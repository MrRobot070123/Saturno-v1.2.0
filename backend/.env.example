# Base de datos
DATABASE_URL="postgresql://hotel_app:CHANGE_ME@localhost:5432/hotel_cases?schema=public"

# JWT
JWT_SECRET="CHANGE_ME_ACCESS_SECRET"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:4200"

# Seguridad
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Multi-hotel (código del hotel sembrado por defecto)
DEFAULT_HOTEL_CODE="HTL-DEMO-01"
